# ═══════════════════════════════════════════
# SkillCortex Backend – Environment Variables
# ═══════════════════════════════════════════

# REQUIRED: Google Gemini AI API key
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# REQUIRED for production: A strong random secret for JWT signing
# Generate one with: openssl rand -hex 32
# WARNING: Do not use the default value in production!
JWT_SECRET_KEY=change-me-in-production-use-a-real-secret

# Optional: Token expiry in minutes (default: 1440 = 24 hours)
# JWT_EXPIRE_MINUTES=1440

# Optional: Allowed CORS origins (comma-separated)
# Include your Vercel frontend URL when deployed
# CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Optional: Database URL (default: SQLite at backend/data/ai_career.db)
# For PostgreSQL on Render:
# DATABASE_URL=postgresql://user:password@host:5432/skillcortex

# ═══════════════════════════════════════════
# HirePilot Backend – Environment Variables
# ═══════════════════════════════════════════

# ── REQUIRED ────────────────────────────────────────────────

# Google Gemini AI API key (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# A strong random secret for JWT signing
# Generate one with: openssl rand -hex 32
# WARNING: Do not use the default value in production!
JWT_SECRET_KEY=change-me-in-production-use-a-real-secret

# ── OPTIONAL ────────────────────────────────────────────────

# Token expiry in minutes (default: 1440 = 24 hours)
# JWT_EXPIRE_MINUTES=1440

# Allowed CORS origins (comma-separated)
# Include your Vercel frontend URL when deployed
# CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Set to "development" to auto-create a demo account on startup
# Demo credentials: demo / Demo@123
# HIREPILOT_ENV=development

# Database URL (default: SQLite at backend/data/ai_career.db)
# For PostgreSQL on Render: DATABASE_URL=postgresql://user:pass@host:5432/db
# DATABASE_URL=

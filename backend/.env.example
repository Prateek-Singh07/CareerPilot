# ═══════════════════════════════════════════════════════════
# CareerPilot AI Backend – Environment Variables
# ═══════════════════════════════════════════════════════════

# ── REQUIRED ────────────────────────────────────────────────

# Primary Google Gemini AI API key (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_primary_gemini_api_key_here

# A strong random secret for JWT signing
# Generate one with: openssl rand -hex 32
# WARNING: Do not use the default value in production!
JWT_SECRET_KEY=change-me-in-production-use-a-real-secret

# ── OPTIONAL FALLBACK GEMINI API KEYS ───────────────────────
# Optional fallback credentials used when primary key is unavailable or invalid.
# Note: Keys from the same Google Cloud project share the project-level rate limit.
# GEMINI_API_KEY_2=your_fallback_gemini_api_key_2_here
# GEMINI_API_KEY_3=your_fallback_gemini_api_key_3_here
# GEMINI_API_KEY_4=your_fallback_gemini_api_key_4_here
# GEMINI_API_KEY_5=your_fallback_gemini_api_key_5_here

# ── PRESENTATION DEMO MODE ──────────────────────────────────
# Set to "true" to run all 4 AI features in presentation demo mode
# without consuming live Gemini API quota or requiring network access.
DEMO_MODE=false

# ── OPTIONAL AI & RUNTIME CONFIGURATION ─────────────────────

# Gemini Model name (default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Token expiry in minutes (default: 1440 = 24 hours)
# JWT_EXPIRE_MINUTES=1440

# Allowed CORS origins (comma-separated)
# CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Set to "development" to auto-create a demo account on startup
# Demo credentials: demo / Demo@123 (or demo@careerpilot.ai / Demo@123)
CAREERPILOT_ENV=development
# Legacy alias supported for backward compatibility:
# HIREPILOT_ENV=development

# Database URL (default: SQLite at backend/data/ai_career.db)
# For PostgreSQL on Render: DATABASE_URL=postgresql://user:pass@host:5432/db
# DATABASE_URL=
